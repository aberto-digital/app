{
	email suporte.abertodigital@gmail.com
	# HTTPS automático para os endereços próprios de agenda dos clientes (ex.: agendar.megahairmarcela.com.br).
	# Só emite certificado para domínio que alguma agenda ativa usa (o PocketBase responde).
	on_demand_tls {
		ask http://ad-pocketbase:8090/api/agenda-dominio/ok
	}
}

# API e painel do AbertoCore
api.abertodigital.com {
	encode zstd gzip
	reverse_proxy ad-pocketbase:8090
}

# Sites de clientes (arquivos em infra/sites/<cliente>, servidos daqui com HTTPS automático)
megahairmarcela.com.br {
	encode zstd gzip
	root * /srv/sites/megahairmarcela
	file_server
	header /fotos/* Cache-Control "public, max-age=604800"
}
www.megahairmarcela.com.br {
	redir https://megahairmarcela.com.br{uri} permanent
}

# Agenda online no endereço do cliente: o cliente cria no DNS dele um CNAME (ex.: agendar -> api.abertodigital.com)
# e coloca o endereço em AbertoCore > Ajustes > Agendamento online. Endereços com bloco próprio acima têm prioridade.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	handle /api/* {
		reverse_proxy ad-pocketbase:8090
	}
	handle {
		root * /srv/sites/_agendar
		try_files {path} /index.html
		file_server
	}
}

# Outros projetos na mesma VPS: cada um publica seus blocos em /srv/tj-site/*.caddy
# pelo próprio repositório. Aqui só incluímos; nada deles fica neste repo.
import /srv/tj/*.caddy
