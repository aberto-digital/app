{
	email suporte.abertodigital@gmail.com
}

# API e painel do AbertoCore
api.abertodigital.com {
	encode zstd gzip
	reverse_proxy ad-pocketbase:8090
}

# Sites de clientes (arquivos em infra/sites/<cliente>, servidos daqui com HTTPS automático)
megahairmarcela.com.br {
	encode zstd gzip
	root * /srv/sites/megahairmarcela
	file_server
	header /fotos/* Cache-Control "public, max-age=604800"
}
www.megahairmarcela.com.br {
	redir https://megahairmarcela.com.br{uri} permanent
}

# TradingJourney: Supabase self-hosted (API, login, arquivos, funções e o painel Studio)
api.tradingjourney.com.br {
	encode zstd gzip
	reverse_proxy supabase-envoy:8000
}

# TradingJourney: site (build em /srv/tj-site/www pelo tradingjourney/publica.sh)
# beta = teste antes da virada; www e o domínio sem www entram na virada do DNS
beta.tradingjourney.com.br {
	encode zstd gzip
	root * /srv/tj/www
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
